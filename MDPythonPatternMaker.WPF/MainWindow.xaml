<Window x:Class="MDPythonPatternMaker.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image to MD Python Tool" Height="500" Width="1000">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,15">
            <Button x:Name="BtnLoad" Content="画像を読み込む" Width="120" Height="30" Margin="0,0,10,0" Click="BtnLoad_Click"/>
            <Button x:Name="BtnConvert" Content="パターンに変換" Width="120" Height="30" Click="BtnConvert_Click"/>
        </StackPanel>

        <Button x:Name="BtnCopy" Content="Pythonコードをコピー" Grid.Row="0" Grid.Column="2" 
                Width="150" Height="30" HorizontalAlignment="Right" Click="BtnCopy_Click"/>

        <GroupBox Header="Original Image" Grid.Row="1" Grid.Column="0" Margin="5">
            <Image x:Name="ImgSource" Stretch="Uniform"/>
        </GroupBox>

        <GroupBox Header="Vector Preview" Grid.Row="1" Grid.Column="1" Margin="5">
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="CanvasVector" Background="#F0F0F0"/>
            </Viewbox>
        </GroupBox>

        <GroupBox Header="Generated Python Script" Grid.Row="1" Grid.Column="2" Margin="5">
            <TextBox x:Name="TxtPython" TextWrapping="NoWrap" AcceptsReturn="True" 
                     FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True"/>
        </GroupBox>
    </Grid>
</Window>