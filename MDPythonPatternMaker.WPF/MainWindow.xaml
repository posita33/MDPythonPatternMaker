<Window x:Class="MDPythonPatternMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image to MD Python Tool" Height="800" Width="1200" Background="#F0F0F0">

    <Window.Resources>
        <Style x:Key="ResetButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="↺"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFCC00"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,10,0">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="📁 ファイル操作" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>
                <Button x:Name="BtnLoad" Content="画像読み込み" Height="40" Click="BtnLoad_Click" Margin="0,0,0,20"/>

                <TextBlock Text="🔄 パターン変換" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>

                <StackPanel Margin="0,0,0,15">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="出力スケール (0.1 - 10.0)" FontSize="11" VerticalAlignment="Center"/>
                        <Button Click="BtnResetScale_Click" DockPanel.Dock="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ResetButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=SldScale, Path=Value}" Value="1.0">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBox Text="{Binding ElementName=SldScale, Path=Value, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="45" DockPanel.Dock="Right" TextAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="SldScale" Minimum="0.1" Maximum="10.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="滑らかさ (0.001 - 0.050)" FontSize="11" VerticalAlignment="Center"/>
                        <Button Click="BtnResetEpsilon_Click" DockPanel.Dock="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ResetButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=SldEpsilon, Path=Value}" Value="0.005">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBox Text="{Binding ElementName=SldEpsilon, Path=Value, StringFormat={}{0:F3}, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="45" DockPanel.Dock="Right" TextAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="SldEpsilon" Minimum="0.001" Maximum="0.050" Value="0.005" TickFrequency="0.001" IsSnapToTickEnabled="True" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="ノイズ除去 (0 - 500)" FontSize="11" VerticalAlignment="Center"/>
                        <Button Click="BtnResetMinArea_Click" DockPanel.Dock="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ResetButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=SldMinArea, Path=Value}" Value="30">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBox Text="{Binding ElementName=SldMinArea, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="45" DockPanel.Dock="Right" TextAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="SldMinArea" Minimum="0" Maximum="500" Value="30" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,25">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="赤判定感度 (50 - 255)" FontSize="11" VerticalAlignment="Center"/>
                        <Button Click="BtnResetRedThr_Click" DockPanel.Dock="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ResetButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=SldRedThr, Path=Value}" Value="200">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBox Text="{Binding ElementName=SldRedThr, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="45" DockPanel.Dock="Right" TextAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="SldRedThr" Minimum="50" Maximum="255" Value="200" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,5,0,0"/>
                </StackPanel>

                <Button x:Name="BtnConvert" Content="変換" Height="50" Click="BtnConvert_Click" 
                        IsEnabled="False" Background="#FF007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="⚡ Python" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>

                <Button x:Name="BtnCopy" Content="コードをコピー" Height="35" Click="BtnCopy_Click" IsEnabled="False"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="0,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Margin="0,0,0,5">
                <GroupBox.Header>
                    <TextBlock Text="🖼 Original Image" FontWeight="Bold" FontSize="12"/>
                </GroupBox.Header>
                <Grid Background="#F8F8F8">
                    <Image x:Name="ImgSource" Stretch="Uniform"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Margin="0,5,0,0">
                <GroupBox.Header>
                    <TextBlock Text="📐 Vector Preview" FontWeight="Bold" FontSize="12"/>
                </GroupBox.Header>
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="CanvasVector" Background="#E5E5E5"/>
                </Viewbox>
            </GroupBox>
        </Grid>
        <GroupBox Grid.Column="2" Margin="5,0,0,0">
            <GroupBox.Header>
                <TextBlock Text="📋 Pythonコード" FontWeight="Bold" FontSize="12"/>
            </GroupBox.Header>
            <TextBox x:Name="TxtPython" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                     FontFamily="Consolas" IsReadOnly="True" Background="#F8F8F8" Padding="10"/>
        </GroupBox>
    </Grid>
</Window>